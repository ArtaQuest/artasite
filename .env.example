# ArtaQuest secrets — environment template.
#
# The database is PUBLIC (the Data explorer serves every table/row), so secrets must NEVER
# be stored in it. Put them here (copy to a real `.env`, which is gitignored) OR define them
# as constants in wp-config.php (also gitignored). Code reads them via AQ\Secrets::get('NAME')
# — env first, then a wp-config constant, never the DB, never hardcoded.
#
# Studio/WASM note: getenv() is unavailable locally, so for local dev define these as
# constants in wp-config.php instead, e.g.  define( 'STRIPE_SECRET_KEY', 'sk_test_…' );

# Payments (only when the paid checkout is wired; free enrolment needs none today)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google sign-in: the CLIENT ID is public (injected into the page) and may stay in options;
# a client SECRET (only if a server-side OAuth code flow is ever added) goes here, never the DB.
GOOGLE_OAUTH_CLIENT_SECRET=

# Contributions: AI triage + autonomous ticket worker
# Triage runs on the operator's relay (no model key lives on the site).
# AQ_WORKER_TOKEN is the shared secret the external worker (tools/ticket-agent/) sends as the
# X-AQ-Worker header; an unset token means no worker access (closed by default).
AQ_WORKER_TOKEN=

# @arta — the public assistant. Mentions queue in the site DB (aq_mentions); the brain (arta-brain/,
# a daemon on the operator's VM) PULLS them and posts replies with this token. Unset = mentions wait.
# AQ_ARTA_REPLY_TOKEN    ≥32-char token the brain sends as X-Arta-Token (ARTA_REPLY_TOKEN there)
AQ_ARTA_REPLY_TOKEN=

# Transactional email via Azure Communication Services (falls back to wp_mail/SMTP when unset).
# AQ_ACS_EMAIL_CONNECTION "endpoint=https://<resource>.communication.azure.com/;accesskey=<key>"
# AQ_ACS_EMAIL_SENDER     a verified sender, e.g. DoNotReply@mail.artaquest.com
AQ_ACS_EMAIL_CONNECTION=
AQ_ACS_EMAIL_SENDER=

# Any future third-party API keys follow the same rule — here or wp-config, never wp_options.
