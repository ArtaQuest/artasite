# ── Build output ─────────────────────────────────────────────────────────────
# The SPA is compiled into the theme. It is regenerated by `npm run build` and is
# never committed: a build from one working copy would otherwise overwrite another's.
wp-content/themes/artaquest-theme/app/
artaquest-web/dist/
node_modules/

# ── Secrets ──────────────────────────────────────────────────────────────────
# Nothing secret belongs in this repository OR in the database — the whole database is
# public by design. Secrets resolve from an environment variable or a wp-config.php
# constant, via AQ\Secrets::get(). See SECURITY.md.
wp-config.php
.env
.env.*
!.env.example
*.pem
*.key
**/kaggle.json
**/credentials.json

# ── WordPress runtime ────────────────────────────────────────────────────────
wp-admin/
wp-includes/
wp-content/uploads/
wp-content/database/
wp-content/db.php
wp-content/mu-plugins/sqlite-database-integration/
wp-content/plugins/sqlite-database-integration/

# ── Derived data ─────────────────────────────────────────────────────────────
# The scripts under analysis/ are committed; their outputs are not. Regenerate them
# rather than storing them — several run to tens of megabytes.
__pycache__/
*.pyc
*.npz
*.zip
*.tar
*.tar.gz
*.gz
analysis/**/*.csv
analysis/**/*.json
!analysis/**/*.config.json

# ── Local ────────────────────────────────────────────────────────────────────
.DS_Store
*.log
debug.log

# Editor / assistant tooling — local, never part of the project
.claude/
.cursor/

# ── Server-only competition data ─────────────────────────────────────────────
# Holdout answer keys, the public/private split, and the test-month actuals. On the
# server these are guarded (`AQ_COMP_SOLUTION`, a direct HTTP request 404s) — but that
# guard protects the WEB SERVER, not a public git repository, where the same file is
# plain text anyone can read. They must never be published again.
wp-content/plugins/aquest/data/competitions/
