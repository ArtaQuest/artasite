# Arta brain — settings. install.sh copies this to ~/.config/arta-brain/env (mode 600) and asks for the
# secrets; never commit a filled-in copy. Nothing here is a paid API: the brain answers only through the
# chat subscription signed in to the browser profile, and waits when that is unavailable.

# ── The site ──────────────────────────────────────────────────────────────────────────────────────────
WP_BASE_URL=https://artaquest.com
# Same value as AQ_ARTA_REPLY_TOKEN in the site Vault (wp-admin → ArtaQuest Security). ≥32 chars.
ARTA_REPLY_TOKEN=

# ── Bug reports → GitHub issues ───────────────────────────────────────────────────────────────────────
# Fine-grained PAT: repository ArtaQuest/artasite only, permission Issues: read & write. Nothing else.
GITHUB_ISSUES_TOKEN=
GITHUB_REPO=ArtaQuest/artasite
BUGS_PER_USER_PER_DAY=3
BUGS_PER_DAY=40

# ── The chat page (operator setting; deliberately not named in the repo) ───────────────────────────
ARTA_CHAT_URL=
# CSS selectors for that page. ARTA_SEL_ANSWER is found by `install.sh calibrate` after sign-in.
ARTA_SEL_INPUT='textarea, div[contenteditable="true"]'
ARTA_SEL_SEND=
ARTA_SEL_ANSWER=

# ── Pace: one prompt at a time, slow and capped. Over the caps, mentions simply wait in the queue. ────
ARTA_MIN_GAP_SEC=45
ARTA_PER_HOUR=30
ARTA_PER_DAY=300
ARTA_ANSWER_TIMEOUT_SEC=120
ARTA_BUSY_PAUSE_SEC=3600
ARTA_DOWN_PAUSE_SEC=600

# 1 = compose answers and log them, post nothing (first smoke test).
ARTA_DRY_RUN=1
