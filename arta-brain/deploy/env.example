# Arta brain — settings. install.sh copies this to ~/.config/arta-brain/env (mode 600) and asks for the
# secrets; never commit a filled-in copy. Nothing here is a paid API: the brain answers only through the
# chat subscription signed in to the browser profile, and waits when that is unavailable.

# ── The site ──────────────────────────────────────────────────────────────────────────────────────────
WP_BASE_URL=https://artaquest.com
# Same value as AQ_ARTA_REPLY_TOKEN in the site Vault (wp-admin → ArtaQuest Security). ≥32 chars.
ARTA_REPLY_TOKEN=

# ── Bug reports → GitHub issues ───────────────────────────────────────────────────────────────────────
# Fine-grained PAT: repository ArtaQuest/artasite only, permission Issues: read & write. Nothing else.
GITHUB_ISSUES_TOKEN=
GITHUB_REPO=ArtaQuest/artasite
BUGS_PER_USER_PER_DAY=3
BUGS_PER_DAY=40

# ── The chat page (operator setting; deliberately not named in the repo) ───────────────────────────
ARTA_CHAT_URL=
# CSS selectors for that page. ARTA_SEL_ANSWER is found by `install.sh calibrate` after sign-in.
ARTA_SEL_INPUT='textarea, div[contenteditable="true"]'
ARTA_SEL_SEND=
ARTA_SEL_ANSWER=
# The page's "new chat" control. Every mention is asked in a NEW conversation (new tab on ARTA_CHAT_URL);
# if the page reopens an earlier one instead, this is clicked — and if an earlier answer is still on
# screen, Arta refuses to send rather than mix one member's context into another's answer.
ARTA_SEL_NEW_CHAT=

# ── Effort and files ───────────────────────────────────────────────────────────────────────────────
# Each new conversation is switched to the highest-effort mode the account offers, in this order; a mode
# the account lacks is skipped (and logged once). The choice is verified by reading the picker back.
ARTA_MODE_LABELS=Heavy,Expert,Thinking,Auto
# ARTA_SEL_MODE=            the picker button (default: the composer button labelled with a mode name)
# ARTA_SEL_MODE_ITEM=       its options (default: [role=menuitem], [role=menuitemradio], [role=option])
# ARTA_SEL_FILE=            the attach control's file input (default: input[type="file"])
# ARTA_SEL_ATTACH=          a button to click first if the file input only appears after it
# ARTA_SEL_BUSY=            visible while an answer is still being written (default: a "Stop…" button)
# ARTA_SEL_OUT_IMAGE=       pictures the chat GENERATED — the only pictures ever attached to a reply
#                           (default: img[alt="Generated image" i], img[src*="/generated/"]; source favicons,
#                           source cards, avatars and icons are never attached)
# ARTA_SEL_UPLOADING=       visible while an attachment uploads (default: progressbar / aria-busy)
# Top-effort modes think for minutes: an answer may take this long before it is abandoned.
ARTA_ANSWER_TIMEOUT_SEC=600
ARTA_STABLE_SEC=4
# Files IN (from the mention's post and the posts above it) and OUT (generated images, full long answers).
ARTA_ATTACH_MAX=4
ARTA_ATTACH_MB=20
ARTA_OUT_FILES_MAX=4
ARTA_OUT_FILE_MB=10

# ── Pace: one prompt at a time, slow and capped. Over the caps, mentions simply wait in the queue. ────
ARTA_MIN_GAP_SEC=45
ARTA_PER_HOUR=30
ARTA_PER_DAY=300
ARTA_BUSY_PAUSE_SEC=3600
ARTA_DOWN_PAUSE_SEC=600

# 1 = compose answers and log them, post nothing (first smoke test).
ARTA_DRY_RUN=1

# ── On the operator's Mac only (deploy/macos/arta-brain.sh sets these defaults) ─────────────────────
# ARTA_BROWSER_CHANNEL=chrome       drive the installed Google Chrome instead of downloading Chromium
# ARTA_HEADLESS=0                   a visible window (1 = headless, if the chat page keeps working that way)
# ARTA_PROFILE_DIR / ARTA_STATE_DIR default to ~/ArtaBrain/chrome-profile and ~/ArtaBrain/state
